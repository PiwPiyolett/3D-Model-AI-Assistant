# Copy this file to ".env" (same folder).
# The app auto-detects which providers are available. Local (Ollama) needs no key.

# ── Local LLM (Ollama) ── runs on your machine, no key, private ───
# Install Ollama, then: ollama pull qwen2.5:7b
# The app uses this by default whenever Ollama is running.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── Gemini (Google AI Studio) ── FREE tier available ──────────────
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Claude (Anthropic) ───────────────────────────────────────────
# Get a key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenAI (ChatGPT) ─────────────────────────────────────────────
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ── Server ────────────────────────────────────────────────────────
PORT=3000
